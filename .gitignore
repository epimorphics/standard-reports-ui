# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore vscode config
.vscode

# Ignore bundler config.
/.bundle
/vendor/bundle

# Ignore Ruby & Rails
*.gem
*.rbc
/.config
/coverage/
/InstalledFiles
/lib/bundler/man/
/pkg/
/spec/reports/
/spec/examples.txt
/test/tmp/
/test/version_tmp/
/tmp/

# Ignore RubyLSP config.
/.ruby-lsp

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
C:\\nppdf32Log\\debuglog.txt

# Ignore Byebug command history file.
.byebug_history

# Node (Playwright only — not used in the application build)
node_modules/
.yarn/*
!.yarn/releases

# Ignore precompiled javascript packs
/public/packs
/public/packs-test
/public/assets

# Ignore uploaded files in development
/storage/*
!/storage/.keep
/public/uploads

### Rails specific ###
.byebug_history
/public/system
/coverage/
tmp

# Ignore files specific to the development environment
fc.json
fc_simple.json
index-names.txt
index.json
tags

# Ignore dot files used by environment or IDE tools
.DS_Store
.github-token
.npmrc
.tags
.tool-versions

# Ignore local configuration files
.env
.env*.local
!.env.development

# Ignore automatically generated js-routes files.
/app/assets/javascripts/routes.js
/app/assets/javascripts/routes.d.ts

# Ignore Standard Reports Manager configuration file download logs
wget-log

